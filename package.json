{
  "name": "ds-agent-kit",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs}\"",
    "typecheck": "tsc --noEmit",
    "agents:sync": "node scripts/kit/sync.mjs",
    "kit:pack": "node scripts/kit/pack.mjs",
    "kit:install": "node scripts/kit/install.mjs",
    "kit:install-from-git": "node scripts/kit/install-from-git.mjs",
    "kit:upgrade": "node scripts/kit/upgrade.mjs",
    "kit:check": "node scripts/kit/check.mjs",
    "kit:bootstrap": "node scripts/kit/bootstrap.mjs",
    "kit:init": "node scripts/kit/init.mjs",
    "kit:identity-scan": "node scripts/kit/identity-scan.mjs",
    "skills:check": "tsx scripts/skills/check.ts",
    "agent:contract": "tsx scripts/agent-contract/run.ts",
    "test:unit": "vitest run --project unit",
    "verify:fast": "pnpm kit:check && pnpm skills:check && pnpm test:unit",
    "verify": "pnpm verify:fast"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "prettier": "^3.8.3",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
